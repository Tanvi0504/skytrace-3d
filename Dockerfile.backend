FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# CPU-first image. GPU deployment requires a CUDA-compatible host/runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg colmap \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt pyproject.toml README.md ./
# Keep the CPU-first image free of CUDA wheels. Installing this exact CPU wheel
# first also gives Ultralytics a reproducible compatible PyTorch dependency.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.5.1 \
    && pip install --no-cache-dir -r requirements.txt

COPY backend ./backend
COPY pipeline ./pipeline
COPY skytrace ./skytrace
COPY config ./config
COPY docs ./docs
COPY outputs/processed-demo ./outputs/processed-demo

EXPOSE 8000
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
